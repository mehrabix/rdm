{
  "manifest_version": 3,
  "name": "RDM — Download with RDM",
  "version": "0.2.0",
  "description": "Send links and page media to RDM (Rust Download Manager) — right-click, or the toolbar button.",
  "background": { "scripts": ["background.js"] },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RDM",
    "default_icon": { "128": "icons/icon-128.png" }
  },
  "permissions": ["nativeMessaging", "contextMenus", "storage", "notifications", "activeTab", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": { "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "rdm@mehrabix.github.io",
      "strict_min_version": "115.0"
    }
  }
}
