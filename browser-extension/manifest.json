{
  "manifest_version": 3,
  "name": "RDM — Download with RDM",
  "version": "0.2.4",
  "description": "Send links and page media to RDM (Rust Download Manager) — right-click, or the toolbar button.",
  "key": "",
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RDM",
    "default_icon": { "128": "icons/icon-128.png" }
  },
  "permissions": ["nativeMessaging", "contextMenus", "storage", "notifications", "activeTab", "cookies"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": { "128": "icons/icon-128.png" }
}
