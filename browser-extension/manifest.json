{
  "manifest_version": 3,
  "name": "RDM — Download with RDM",
  "version": "0.3.4",
  "description": "Detect video and audio on any site and hand it to RDM (Rust Download Manager) — right-click, the toolbar button, or the badge over each video.",
  "key": "",
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RDM",
    "default_icon": { "128": "icons/icon-128.png" }
  },
  "permissions": ["nativeMessaging", "contextMenus", "storage", "notifications", "activeTab", "cookies", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": { "128": "icons/icon-128.png" }
}
